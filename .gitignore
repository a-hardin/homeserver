.env
/vendor
/node_modules
/.vagrant
composer.lock
/homeassistant
/system/mosquitto

# Hermes — real env files (never commit secrets)
system/hermes/personal/.env
system/hermes/family/.env
system/hermes/stonkbot/.env

# Trader — real env file (Alpaca paper keys; never commit secrets)
system/trader/.env

# Hermes — runtime data written by the agent into profile dirs.
# Ignore everything in each profile except the two tracked files.
system/hermes/*/*
!system/hermes/*/.env.example
!system/hermes/*/SOUL.md

# Runtime data and secrets created on the server
/cache/
/system/portainer/
/system/wireguard/